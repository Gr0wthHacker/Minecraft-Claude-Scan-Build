out/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
chunkscan/build/
chunkscan/.gradle/
chunkscan/run/
# keep the small, shareable artefacts: baseline + current scans and design outputs (regenerable, but teammates want them)
!out/
out/*
!out/*.litematic
!out/*.scan.json
# the mod reads these to diff a design against the live world; they ship with the designs
!out/*.work.json
!out/_test/
out/_test/*

# your machine's paths stay yours; copy profile.example.yaml instead
profile.yaml
.claude/settings.local.json

# game logs are rewritten every session and kept dirtying the tree
logs/
chunkscan/logs/
